Private Sub CloseWorkbook_Click()
    Dim response As VbMsgBoxResult
    response = MsgBox("Are you sure you want to close this workbook?", vbYesNo)
    If response = vbYes Then
        Application.DisplayAlerts = False
        ActiveWorkbook.Close
        Application.DisplayAlerts = True
        Application.ScreenUpdating = True
    End If
End Sub

Private Sub LS_Click()
    dBody = "LS"    'the old pre-2014 Programmes

    ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B3").Value = strOrg & "  -  " & dBody
    ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B4").Value = "Pre - 2014 RD Programme"
    
    dBody = strOrg & dBody      ' #### e.g.NELS
    
    Dim response As VbMsgBoxResult
    If strOrg = "NE" Then
        response = MsgBox("EU (Pre 2014): HLS, ELS, OELS, CSS, ESA, Habitat, HTB, HAC, ETIP, CSF, P4C has been selected" & vbNewLine & "Is this correct?", vbYesNo)
    Else
        response = MsgBox("EU (Pre 2014) has been selected" & vbNewLine & "Is this correct?", vbYesNo)
    End If

    If response = vbYes Then
        Call SelectFormNEFCAR.Hide
        Call SetValRng
        Call PrepAPorAR
    End If
End Sub

