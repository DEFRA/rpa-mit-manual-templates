Private Sub CS_Click()

    
    If strOrg = "RDT" Then
        dBody = "CP"        'the new 2014 - 2020 Pillar 2 Programme
    ElseIf strOrg = "EA" Then
        dBody = "EA"
    Else
        dBody = "CS"
    End If
    
    If strOrg <> "EA" Then
        dBody = strOrg & dBody 'e.g. NECS
    End If
End Sub

Private Sub CSDom_Click()
    Application.ScreenUpdating = False
    
    dBody = "CSDom"
    
    If strOrg = "RDT" Then
        dBody = "CPDom"        'the new 2014 - 2020 Pillar 2 Programme
    End If
    
    
    dBody = strOrg & dBody ' e.g. NECS
End Sub

Private Sub P1_Click()


    
    dBody = "P1"    'NE P1 schemes
    
    If strOrg = "RDT" Then
        dBody = "Dom"
        ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B3").Value = strOrg & "  -  Domestic"
    Else
        ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B3").Value = strOrg & "  -  " & dBody
    End If
    
End Sub



