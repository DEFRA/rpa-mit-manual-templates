Private Sub P1_Click()

If strExNRDPE = "ExNRDPE" Then
    Call ExNRDPE_Divert
Else
    Application.ScreenUpdating = False
    
    dBody = "P1"    'NE P1 schemes
    
    If strOrg = "RDT" Then
        dBody = "Dom"
        ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B3").Value = strOrg & "  -  Domestic"
    Else
        ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B3").Value = strOrg & "  -  " & dBody
    End If
    
    ActiveWorkbook.Worksheets("Main Page - " & WBTYpe).Range("B4").Value = "Domestic Schemes"
    dBody = strOrg & dBody          'e.g. NECS
    Dim response As VbMsgBoxResult
    If strOrg = "NE" Or strOrg = "RDT" Then
        response = MsgBox("Domestic Schemes has been selected" & vbNewLine & "Is this correct?", vbYesNo)
    Else
        response = MsgBox("New Schemes has been selected" & vbNewLine & "Is this correct?", vbYesNo)
    End If
    
    If response = vbYes Then
        Call SelectFormNEFCAR.Hide
        Call SetValRng
        Call PrepAPorAR
    End If
End If

End Sub

Private Sub UserForm_Activate()
    Me.Left = GetLeftFormOffset(Me.Width)
    Me.Top = GetTopFormOffset(Me.Height)
End Sub

